.DS_Store
.venv/
.cache/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local/raw/generated data
dataset/
data/raw/*
data/interim/*.csv
data/processed/*.csv

# Large generated report tables
reports/tables/f10_uc4_risk_classifier_test_predictions.csv

# Keep folder structure
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Large model artifacts
models/
*.keras
*.h5
*.pkl
*.joblib
# Exception: production model needed for Render deployment
!biosense360/backend/ml/model.pkl
# Exception: backend ORM package (not an ML artifact dir) — required at runtime
!biosense360/backend/models/
!biosense360/backend/models/*.py

# Notebook checkpoints
.ipynb_checkpoints/

# Frontend build artifacts and dependencies
biosense360/frontend/node_modules/
biosense360/frontend/dist/
